{
  "name": "zhishu-webui",
  "version": "1.0.19",
  "private": true,
  "description": "智枢智能体 前端（Vue3 + Vite + Naive UI，同源调用后端，零境外直连）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check:tdz": "node scripts/tdz-scan.mjs",
    "check:render": "node scripts/render-check.build.mjs && node scripts/.render-out/render-check.mjs",
    "build": "node scripts/tdz-scan.mjs && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "echarts": "^5.6.0",
    "naive-ui": "^2.38.0",
    "pinia": "^2.1.7",
    "vue": "^3.4.0",
    "vue-i18n": "^9.14.4",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "jsdom": "^29.1.1",
    "sass": "^1.101.3",
    "typescript": "^5.4.0",
    "vite": "^5.2.0"
  },
  "engines": {
    "node": ">=18"
  },
  "comments": {
    "registry": "安装请使用国内镜像：npm config set registry https://registry.npmmirror.com"
  }
}
