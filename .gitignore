# ===== 依赖 / 虚拟环境 =====
.venv/
venv/
env/
*/.venv/
frontend/node_modules/

# ===== 运行时数据与日志（含记忆库 / 沙箱 / 上传文件，禁止入库）=====
data/
_old_builds/
*.log
backend_run.log
*.db
*.sqlite
*.sqlite3

# ===== 构建产物（前端由 `npm run build` 生成到 backend/zhishu/static）=====
# 为保远端部署与本地运行版本一致，正式构建产物随仓库分发。
# 本地 dev build 请勿误提交；如需忽略本地改动，可用 git update-index --skip-worktree。
!backend/zhishu/static/
frontend/vite.config.ts.timestamp-*.mjs

# ===== 真实配置（含密钥，禁止入库；请用 zhishu.yaml.example 复制）=====
deploy/zhishu.yaml
.env
.env.*
*.local

# ===== Python 缓存 =====
__pycache__/
*.py[cod]
*$py.class
.mypy_cache/
.pytest_cache/
.ruff_cache/

# ===== 临时 / 草稿脚本（本会话排查用，不入库）=====
backend/_*.py
backend/adjtest.py

# ===== 系统 / 编辑器 =====
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ===== 例外：内置 MCP 演示服务（静态示例，随仓库分发；非用户运行时数据）=====
!backend/data/
!backend/data/mcp/
!backend/data/mcp/echo-demo/
!backend/data/mcp/echo-demo/mcp.json
!backend/data/mcp/echo-demo/server.py

# ===== 例外：部署用 Dockerfile（构建必需，需入库；但真实配置 zhishu.yaml 仍不入库）=====
!Dockerfile.local
!deploy/Dockerfile.local
